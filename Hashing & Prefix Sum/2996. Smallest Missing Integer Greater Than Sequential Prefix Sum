class Solution {
public:
    int missingInteger(vector<int>& nums) {
        int n=nums.size();
        int prefix=nums[0];
        for(int j=1;j<n;j++){
            if(nums[j]==nums[j-1]+1){
                prefix += nums[j];
            }
            else{
                break;
            }
        }
        unordered_set<int> st(nums.begin(),nums.end());
        while(st.count(prefix)){
            prefix++;
        }
        return prefix;
    }
};
