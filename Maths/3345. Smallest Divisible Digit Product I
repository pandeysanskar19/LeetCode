class Solution {
public:

    bool CheckDivisble(int n,int k){
        int product =1;
        while(n>0){
            int digits=n%10;
            product *= digits;
            n /= 10;
        }
        if(product%k==0) return true;
        else{
            return false;
        }
    }
    int smallestNumber(int n, int t) {
        
        for(int i=n;i<n+t;i++){
            if(CheckDivisble(i,t)==true){
               return i;
            }
        }
        return -1;
    }
};
