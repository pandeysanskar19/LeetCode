class Solution {
public:
    int Load(vector<int>& arr,int capacity){
        int day=1;int ld =0;
        for(int i=0;i<arr.size();i++){
            if(capacity<ld+arr[i]){
                day++;
                ld=arr[i];
            }
            else{
                ld += arr[i];
            } 
        }
        return day;
    }
    int shipWithinDays(vector<int>& weights, int days) {
        int n=weights.size();
        int maxi=*max_element(weights.begin(),weights.end());
        int sum=0;
        int reqday=0;
        for(int x=0;x<n;x++){
            sum +=weights[x];
        }
        // for(int c=maxi;c<sum;c++){
        //     reqday =Load(weights,c);
        //     if(reqday<=days){
        //         return c;
        //     }
        // }
        int low=maxi ; int high=sum;
        int ans=0;
        while(low<=high){
            int mid=low+(high-low)/2;
            if(Load(weights,mid) <=days){
                ans= mid;
                high=mid-1;
            }
            else{
                low=mid+1;
            }
        }
        return ans;
    }
};
