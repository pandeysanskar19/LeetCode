// time complexity: O(nlog(maxpile));
// space complexity: O(1)


class Solution {
public:

    long long eattime(vector<int>& arr,int k){
        long long totalhr=0;
        for(int i=0;i<arr.size();i++){
            totalhr += ceil((double)arr[i]/k);//(arr[i]+k-1)/k standard ceiling formula
        }
        return totalhr;
    }
    int minEatingSpeed(vector<int>& piles, int h) {
        int high = *max_element(piles.begin(),piles.end());
        int low=1;
        while(low<=high){
            int mid=low+(high-low)/2;
            long long totalhr = eattime(piles,mid);
            if(totalhr<=h){
                high=mid-1;
            }
            else if(totalhr>h){
                low=mid+1;
            }
        }
        return low;
    }
};
