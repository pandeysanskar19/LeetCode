#METHOD :1  TIME COMPLEXITY: O(N) AND SPACE COMPLEXITY O(1).

class Solution {
public:
    int findKthPositive(vector<int>& arr, int k) {
        int n=arr.size();
        for(int i=0;i<n;i++){
             if(arr[i]<=k){
                 k++;
             }
             else{
                 break;
             }
         }
         return k;


#METHOD :2 TIME COMPLEXITY: O(LOGN) AND SPACE COMPLEXITY O(1).
        int low=0;
        int high=n-1;
        while(low<=high){
            int mid= low+(high-low)/2;
            int miss = arr[mid]-(mid+1);
            if(miss<k){
                low=mid+1;
            }
            else{
                high=mid-1;
            }
        }
        return k+low; //low = high+1
    }
};
