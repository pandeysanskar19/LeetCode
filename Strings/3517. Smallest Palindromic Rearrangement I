class Solution {
public:
    string smallestPalindrome(string s) {

        vector<int> freq(26, 0);

        // Count frequency
        for(char c : s){
            freq[c-'a']++;
        }

        string left = "";
        char middle = '\0';

        // Create smallest left half
        for(int i = 0; i < 26; i++){

            // middle character for odd length
            if(freq[i] % 2 == 1){
                middle = char(i + 'a');
            }

            // add half occurrences
            left += string(freq[i]/2, char(i+'a'));
        }

        string right = left;
        reverse(right.begin(), right.end());

        return left + (middle == '\0' ? "" : string(1,middle)) + right;
    }
};
