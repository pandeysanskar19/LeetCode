class Solution {
public:
    int splitNum(int num) {
        vector<int>arr;
        int num1=0;
        int num2=0;
        while(num>0){
            int r = num%10;
            arr.push_back(r);
            num=num/10;
        }
        sort(arr.begin(),arr.end());
        for(int i=0;i<arr.size();i++){
            if(i%2==0){
                num1=num1*10+arr[i];
            }
            else{
                num2=num2*10+arr[i];
            }
        }
        int ans=num1+num2;
        return ans;
    }
};
